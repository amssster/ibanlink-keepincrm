# Згенеруйте секрети через npm run secrets -- --write
DOMAIN=pay.example.com
APP_URL=https://pay.example.com

# PostgreSQL / Neon (для Neon використовуйте pooled connection string)
DATABASE_URL=postgresql://iban:REPLACE_WITH_POSTGRES_PASSWORD@localhost:55432/iban
POSTGRES_USER=iban
POSTGRES_DB=iban
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Максимальна кількість з'єднань у пулі (10 для Docker/VPS, 1-3 для Serverless/Neon)
DB_POOL_MAX=10

# Авторизація
SESSION_SECRET=REPLACE_WITH_64_HEX
# Використовуйте OWNER_PASSWORD_HASH (рекомендовано) або OWNER_PASSWORD (простий пароль)
OWNER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
# OWNER_PASSWORD=ваш_надійний_пароль

# Webhook-секрети KeepinCRM (Bearer токени)
WEBHOOK_ISSUE_SECRET=REPLACE_WITH_64_HEX
WEBHOOK_PAYMENT_SECRET=REPLACE_WITH_DIFFERENT_64_HEX
